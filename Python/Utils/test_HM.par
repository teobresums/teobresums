# Testing HM

use_geometric_units = 1 # use geometric units for I/O ?
q = 1. # mass ratio
use_spins = 1
chi1 = 0.7 # dimensioneless spin 1 z-component
chi2 = 0.7 # dimensioneless spin 2 z-component
