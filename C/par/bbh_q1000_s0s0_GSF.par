# parfile for BBH (1000,0,0) 
# Inspiral-only model, with potentials augmented with GSF results
#
# Note: the (l,m) = (3,1),(4,1) modes are inspiral only, and do not have a 
# merger-ringdown completion. See 
# https://bitbucket.org/eob_ihes/teobresums/wiki/Conventions,%20parameters%20and%20output

#
# use geometric units for I/O
# everything is given geometric units and binary mass-rescaled 
#

use_geometric_units = "yes"

#
# Binary properties
#

q = 1000. # mass ratio

use_spins = 1
chi1 = 0.0 # dimensionless spin 1 z-component 
chi2 = 0.0 # dimensionless spin 2 z-component 
model =	"Giotto"

# initial GW freq for r0 = 21.0
# f22 = 2*(r0)^(-3/2) / (2*pi)
initial_frequency = 0.0033

#
# Output dir, output modes 
#

output_dir = "./bbh_q1000_s0s0/"
output_hpc = "no" # switch this off to test performances!!!
output_multipoles = "yes"
output_lm   = [ 1 ]
use_mode_lm = [ 1 ]
output_dynamics = "no"
use_flm = "22PN"
A_pot = "GSF"
D_pot = "GSF"
Q_pot = "GSF"
postadiabatic_dynamics_rmin = 8.0
#
# Setup
#

size = 200 # size of the arrays (chunks, dynamically extended)
ode_timestep = "adaptive"
compute_LR = "no" # calculate LR ?
compute_LSO = "no" # calculate LSO ?
ode_stop_at_radius = 5. # rLR = 1.81...
ode_tmax = 100000000000000000000
# interpolate on uniform grid?
interp_uniform_grid = "no" # yes, only h+,hx on a grid of dt_interp

dt_interp = 1000000 # M/delta_t = 4096 Hz for M=15*Msun








