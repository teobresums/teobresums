# parfile for BBH q=1 nospin run 
# builds on default options

use_geometric_units = 1 # use geometric units for I/O ?
q = 1. # mass ratio
use_spins = 1 
chi1 = 0.98 # dimensioneless spin 1 z-component 
chi2 = 0.98 # dimensioneless spin 2 z-component 
initial_frequency = 0.0123 # initial GW freq
size = 7100 # size of the arrays (chunks, dynamically extended)
output_lm = [0,1,2,3,4]
output_dynamics = 1
compute_LR = 0 # calculate LR ?
compute_LSO = 0 # calculate LSO ?
ode_timestep = "adaptive"

