# default parameters
# key = val # description

# ----------------------
# physical input pars
# ----------------------

M = 1. # total binary mass
q = 1. # mass ratio

chi1 = 0. # dimensionless spin 1 z-component 
chi2 = 0. # dimensionless spin 2 z-component 

distance = 1. 
inclination = 0.
coalescence_angle = 0.
polarisation = 0.

r0 = 0.	
initial_frequency = 0.004 # initial GW frequency

tides = "no" 
tides_gravitomagnetic = "no"
LambdaAl2 = 0. # Tidal gravitoelectric parameter Lambda for star A ell=2
LambdaBl2 = 0.
LambdaAl3 = 0. 
LambdaAl4 = 0. 
LambdaBl3 = 0. 
LambdaBl4 = 0. 
SigmaAl2 = 0. # Tidal gravitomagnetic parameter Sigma for star A ell=2
SigmaBl2 = 0.
use_Yagi_fits = 0 # use Yagi fit to obtain tidal parameters Lambda_3,4 from Lambda_2 ?
pGSF_tidal = 4.0 # p-power in GSF tidal potential model

use_spins = 0 # use spins ?

# ----------------------
# options
# ----------------------

use_geometric_units = 1 # use geometric units for I/O ?

use_speedytail = 1 # use special routine to speed up tail computation ?

interp_uniform_grid = 0 # interpolate on uniform grid ?
dt_interp = 0.5 # timestep to be used for final interpolation (used if input is given in geometrical unit, unused otherwise)
srate_interp = 4096. # sampling rate to be used for final interpolation (used if input is given in physical unit, unused otherwise)

postadiabatic_dynamics = "no"
postadiabatic_dynamics_N = 8 # post-adiabatic order
postadiabatic_dynamics_size = 1000 # grid size 
postadiabatic_dynamics_rmin = 12. # minimum radius (end of PA dynamics)
postadiabatic_dynamics_stop = "yes" # stop after post-adiabatic dynamics

centrifugal_radius = "LO" # {LO, NLO, NNLO, NNLOS4, NOSPIN, NOTIDES}
use_flm = "SSLO" # "SSLO", "SSNLO"

compute_LR = 0 # calculate LR ?
compute_LSO = 0 # calculate LSO ?
compute_LR_guess = 3.
compute_LSO_guess = 6. 

nqc = "auto" # {"auto", "manual"}
nqc_coefs_flx = "none" # {"none", "nrfit_nospin20160209", "fromfile"}
nqc_coefs_hlm = "none" # {"compute", "none", "nrfit_nospin20160209", "fromfile"}
nqc_coefs_flx_file = ""
nqc_coefs_hlm_file = ""

output_dir = "./data/" # output dir
output_hpc = 1 # output h+,hx
output_multipoles = 0 # output multipoles
output_lm = [-1] # indexes of multipoles to ouput
output_dynamics = 0 # output dynamics
output_nqc = 0 # output NQC waveform
output_nqc_coefs = 0 # output multipolar NQC coefs (if determined)
output_ringdown = 0 # output ringdown waveform

# ----------------------
# Evolution settings
# ----------------------

srate = 4096. # sampling rate, used if input is given in physical unit, reset based on tstep otherwise
dt = 0.5 # timestep, used if input is given in geometric unit, reset based on srate otherwise

size = 1 # size of the arrays (chunks, dynamically extended)
ringdown_extend_array = 500 # grid points to extend arrays for ringdown attachment

ode_timestep = "uniform" # specify ODE solver timestep "uniform","adaptive","adaptive+uniform_after_LSO","undefined"
ode_abstol = 1e-13 # ODE solver absolute accuracy
ode_reltol = 1e-11 # ODE solver relative accuracy
ode_tmax = 1e8 # max integration time
ode_stop_at_radius = 2. # stop ODE integration at this radius (if > 0)
ode_stop_afterNdt = 4 # stop ODE N iters after the Omega peak

# ----------------------
# following pars are set by the code
# ----------------------

nu = 0. # symmetric mass ratio
X1 = 0. # mass ratio M1/M
X2 = 0. # mass ratio M2/M

S1 = 0. # 
S2 = 0. # 
S = 0. # 
Sstar = 0. # 
a1 = 0. # 
a2 = 0. # 
aK = 0. #
aK2 = 0. # 
C_Q1 = 0. #
C_Q2 = 0. #
C_Oct1 = 0. #
C_Oct2 = 0. #
C_Hex1 = 0. #
C_Hex2 = 0. #
cN3LO = 0. #

kappaAl2 = 0. # gravitoelectric kappa star A
kappaAl3 = 0. #
kappaAl4 = 0. #
kappaBl2 = 0. #
kappaBl3 = 0. #
kappaBl4 = 0. #

kappajAl2 = 0. # gravitomagnetic kappa star A
kappajBl2 = 0.
kappajTl2 = 0.

kappaTl2 = 0. #
kappaTl3 = 0. #
kappaTl4 = 0. #
bar_alph2_1 = 0. #
bar_alph2_2 = 0. #
bar_alph3_1 = 0. #
bar_alph3_2 = 0. #
bar_alph2j_1 = 0. #
khatAl2 = 0. #
khatBl2 = 0. #
rLR_tidal = 0. # radius of light-ring for NNLO tidal model

BH_final_mass = 0. # final BH mass
BH_final_spin = 0. # final BH spin

rLR = 0. # radius of light-ring
rLSO = 0. # radius of last stable orbit 

use_tidal = 0 # index for tidal modus
use_tidal_gravitomagnetic = 0 # index for gravitomagnetic tide
