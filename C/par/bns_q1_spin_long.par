# parfile for BNS q=1 nospin run 
# builds on default options

use_geometric_units = 1 # use geometric units for I/O ?
q = 1. # mass ratio
chi1 = 0. # dimensioneless spin 1 z-component 
chi2 = 0. # dimensioneless spin 2 z-component 
initial_frequency = 0.0002 # initial GW freq 
size = 1200 # size of the arrays (chunks, dynamically extended)
output_lm = [0,1,2,3,4]
output_dynamics = 1
compute_LR = 0 # calculate LR ?
compute_LSO = 0 # calculate LSO ?
ode_timestep = "adaptive"
tides = "TEOBRESUM"
LambdaAl2 = 392.060075829611 # Sly 1.35
LambdaBl2 = 392.060075829611
LambdaAl3 = 710.31348374843 
LambdaBl3 = 710.31348374843 
LambdaAl4 = 1248.979660686121 
LambdaBl4 = 1248.979660686121 
use_Yagi_fits = 0
ode_stop_at_radius = 4.5