# parfile for BBH (100, 0., 0.)
# uses the large-mass-ratio binary type (binary = "LMR")
#
# Note: the (l,m) = (3,1),(4,1) modes are inspiral only, and do not have a 
# merger-ringdown completion. See 
# https://bitbucket.org/eob_ihes/teobresums/wiki/Conventions,%20parameters%20and%20output

#
# use geometric units for I/O
# everything is given geometric units and binary mass-rescaled 
#

use_geometric_units = "yes"

#
# Binary properties
#

binary = "LMR"

q = 100. # mass ratio

chi1 = 0. # dimensionless spin 1 z-component 
chi2 = 0. # dimensionless spin 2 z-component 

# initial frequency (geometric units: Omega/pi = f22 at Kepler)
# merger ~1 week after the start for M = 1e6 Msun (122790 M); initial radius ~16.6
initial_frequency = 4.7201982295e-03

#
# Output dir, output modes 
#

output_dir = "./bbh_q100_s0s0_LMR/"
output_hpc = "yes"
output_multipoles = "yes"
output_lm   = [ 0, 1, 4, 8 ] # (2,1), (2,2), (3,3), (4,4)
use_mode_lm = [ 0, 1, 4, 8 ]
output_dynamics = "no"

# postadiabatic_dynamics = "no" # uncomment to solve the full ODEs

#
# Setup
#

size = 200 # size of the arrays (chunks, dynamically extended)
ode_timestep = "adaptive"
compute_LR = "no" # calculate LR ?
compute_LSO = "no" # calculate LSO ?
ode_tmax = 1000000000000000000000


# interpolate on uniform grid?
interp_uniform_grid = "yes" # output on a uniform time grid of step dt_interp

dt_interp = 0.5 # M/delta_t = 4096 Hz for M=15*Msun




