# parfile for BBH q=1 nospin run 
# builds on default options

use_geometric_units = 1 # use geometric units for I/O ?
q = 1. # mass ratio
chi1 = 0. # dimensioneless spin 1 z-component 
chi2 = 0. # dimensioneless spin 2 z-component 
initial_frequency = 0.001
size = 4 # size of the arrays (chunks, dynamically extended)
output_lm = [1,2,3,4]

compute_LR = 1 # calculate LR ?
compute_LSO = 0 # calculate LSO ?
