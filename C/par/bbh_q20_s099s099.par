# parfile for BBH (20,0.99,0.99) 
# ODE run
# builds on default options

#
# use geometric units for I/O
# everything is given geometric units and binary mass-rescaled 
#

use_geometric_units = 1

#
# Binary properties
#

q = 20. # mass ratio

use_spins = 1
chi1 = 0.99 # dimensionless spin 1 z-component 
chi2 = 0.99 # dimensionless spin 2 z-component 

initial_frequency = 0.004 # initial GW freq of 10 Hz for M = 10 M_sun

#
# Output dir, output modes 
#

output_dir = "./bbh_q20_s099s099/"
output_hpc = 1 # switch this off to test performances!!!
output_multipoles = 1
output_lm = [ 1 ];
use_mode_lm = [ 1 ]; # Use only (2,2) mode for BBH h_{+,x}, this will be updated
output_dynamics = 0

#
# Setup
#

size = 200 # size of the arrays (chunks, dynamically extended)
ode_timestep = "adaptive"
compute_LR = 1 # calculate LR ?
compute_LSO = 1 # calculate LSO ?
ode_stop_at_radius = 1.0 # rLR = 1.81...

# interpolate on uniform grid?
#interp_uniform_grid = 0 # no, outputs on a grid of dt = 0.5 
interp_uniform_grid = 1 # yes, only h+,hx on a grid of dt_interp
#interp_uniform_grid = 2 # yes, all modes on a grid of dt_interp

dt_interp = 8.2611264451 # M/delta_t = 4096 Hz for M=6*Msun








