Cell[TextData[{
 "Calculating ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["d", "3"], 
     SubscriptBox["G", 
      SubscriptBox["S", "*"]]}], 
    SuperscriptBox[
     SubscriptBox["du", "c"], "3"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "393ee2ff-c42d-465c-afe7-e8b410148716"],
 " both ways and checking they agree; i.e., by applying the chain rule N \
times to d2GSsdrr2[uc, prstar] above, and by differentiating w.r.t. the \
explicit ucs and the r, etc., as done for d2GSsdr2[uc, prstar]."
}], "Text",
 CellChangeTimes->{{3.938150263848958*^9, 
  3.93815037864596*^9}},ExpressionUUID->"8ef3c36d-d31b-4764-8ca2-\
72f2ec420ad9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"d3GSsdrr3", "[", 
    RowBox[{"uc", ",", "prstar"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "6"}], " ", 
       SuperscriptBox["uc", "4"], " ", 
       SuperscriptBox["drcdr", "3"], " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "+", " ", 
      RowBox[{"4", " ", 
       SuperscriptBox["uc", "3"], "drcdr", " ", "d2rcdr2", " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["uc", "3"], 
       SuperscriptBox["drcdr", "2"], "drcdr", " ", 
       SuperscriptBox["uc", "2"], 
       RowBox[{"d2GSsduc2", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "\[IndentingNewLine]", "+", 
      " ", 
      RowBox[{"2", 
       SuperscriptBox["uc", "3"], "drcdr", " ", "d2rcdr2", " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "-", "  ", 
      RowBox[{
       SuperscriptBox["uc", "2"], "d3rcdr3", " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "+", " ", 
      RowBox[{
       SuperscriptBox["uc", "4"], "drcdr", " ", "d2rcdr2", " ", 
       RowBox[{"d2GSsduc2", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "\[IndentingNewLine]", "-", 
      RowBox[{"4", 
       SuperscriptBox["uc", "5"], 
       SuperscriptBox["drcdr", "3"], 
       RowBox[{"d2GSsduc2", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "+", 
      RowBox[{"2", "  ", 
       SuperscriptBox["uc", "4"], "drcdr", " ", "d2rcdr2", " ", 
       RowBox[{"d2GSsduc2", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "-", " ", 
      RowBox[{
       SuperscriptBox["uc", "6"], 
       SuperscriptBox["drcdr", "3"], 
       RowBox[{"d3GSsduc3", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}]}], ")"}], "/.", "rule"}]}], 
  ";"}]], "Input",
