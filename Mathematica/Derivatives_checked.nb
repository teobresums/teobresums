 RowBox[{
  RowBox[{
   RowBox[{"d3GSsdrr3", "[", 
    RowBox[{"uc", ",", "prstar"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "6"}], " ", 
       SuperscriptBox["uc", "4"], " ", 
       SuperscriptBox["drcdr", "3"], " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "+", " ", 
      RowBox[{"4", " ", 
       SuperscriptBox["uc", "3"], "drcdr", " ", "d2rcdr2", " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["uc", "3"], 
       SuperscriptBox["drcdr", "2"], "drcdr", " ", 
       SuperscriptBox["uc", "2"], 
       RowBox[{"d2GSsduc2", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "\[IndentingNewLine]", "+", 
      " ", 
      RowBox[{"2", 
       SuperscriptBox["uc", "3"], "drcdr", " ", "d2rcdr2", " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "-", "  ", 
      RowBox[{
       SuperscriptBox["uc", "2"], "d3rcdr3", " ", 
       RowBox[{"dGSsduc", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "+", " ", 
      RowBox[{
       SuperscriptBox["uc", "4"], "drcdr", " ", "d2rcdr2", " ", 
       RowBox[{"d2GSsduc2", "[", 
        RowBox[{"uc", ",", "prstar"}], "]"}]}], "\[IndentingNewLine]", "-", 
      RowBox[{"4", 
