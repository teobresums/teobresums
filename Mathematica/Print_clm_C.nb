 CellLabel->"In[23]:=",ExpressionUUID->"b9c5f4a1-9618-497f-b6ac-331788765481"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<<", "Rholm_orb_6PN.m"}], ";"}]], "Input",
 CellChangeTimes->{{3.946026899398563*^9, 3.946026907214381*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"41a30f64-f812-4ca4-a0a0-b2a5d1d00ba2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rulenu", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["nu", "2"], "\[Rule]", " ", "nu2"}], ",", 
     RowBox[{
      SuperscriptBox["nu", "3"], "\[Rule]", " ", "nu3"}], ",", 
     RowBox[{
      SuperscriptBox["nu", "4"], "\[Rule]", " ", "nu4"}], ",", 
     RowBox[{
      SuperscriptBox["nu", "5"], "\[Rule]", "nu5"}], ",", 
     RowBox[{
      SuperscriptBox["nu", "6"], "\[Rule]", "nu6"}], ",", 
     RowBox[{
      SuperscriptBox["nu", "7"], "\[Rule]", " ", "nu7"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rulex", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "6"], "->", "x6"}], ",", 
     RowBox[{
      SuperscriptBox["x", "5"], "->", "x5"}], ",", 
     RowBox[{
      SuperscriptBox["x", "4"], "\[Rule]", " ", "x4"}], ",", 
     RowBox[{
      SuperscriptBox["x", "3"], "\[Rule]", " ", "x3"}], ",", 
     RowBox[{
      SuperscriptBox["x", "2"], "\[Rule]", " ", "x2"}], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Log", "[", "x", "]"}], "4"], "\[Rule]", " ", "log4x"}], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Log", "[", "x", "]"}], "3"], "\[Rule]", " ", "log3x"}], ",", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Log", "[", "x", "]"}], "2"], "\[Rule]", " ", "log2x"}], ",", 
     RowBox[{
      RowBox[{"Log", "[", "x", "]"}], "\[Rule]", " ", "logx"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.702060245344905*^9, 3.702060250746284*^9}, {
  3.9217432412949305`*^9, 3.921743261882045*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"4d474e51-dd9f-41fe-8440-893b06387391"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeparateLogs", "[", 
   RowBox[{"l_", ",", "m_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"CompoundExpression", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rational\[Rho]Orb6PN", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Symbol", "[", 
        RowBox[{"\"\<\[Rho]\>\"", "<>", 
         RowBox[{"ToString", "[", "l", "]"}], "<>", 
         RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<Orb6PN\>\""}], "]"}],
        "[", 
       RowBox[{"x", ",", "\[Nu]"}], "]"}], "/.", 
      RowBox[{
       RowBox[{"Log", "[", "x", "]"}], "->", "0"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Irrational\[Rho]Orb6PN", "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Symbol", "[", 
         RowBox[{"\"\<\[Rho]\>\"", "<>", 
          RowBox[{"ToString", "[", "l", "]"}], "<>", 
          RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<Orb6PN\>\""}], 
         "]"}], "[", 
        RowBox[{"x", ",", "\[Nu]"}], "]"}], "-", "Rational\[Rho]Orb6PN"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Coeff6PNLog1", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"Irrational\[Rho]Orb6PN", ",", 
         RowBox[{"Log", "[", "x", "]"}]}], "]"}], ",", 
       SuperscriptBox["x", "3"]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Log1\[Rho]Orb6PN", "=", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Symbol", "[", 
            RowBox[{"\"\<\[Rho]\>\"", "<>", 
             RowBox[{"ToString", "[", "l", "]"}], "<>", 
             RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\<Orb6PN\>\""}], 
            "]"}], "[", 
           RowBox[{"x", ",", "\[Nu]"}], "]"}], "-", "Rational\[Rho]Orb6PN"}], 
         ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["x", "3"], 
          RowBox[{"Log", "[", "x", "]"}], " ", "Coeff6PNLog1"}], ")"}]}], 
       "]"}], "/.", 
      RowBox[{
       RowBox[{"Log", "[", "x", "]"}], "\[Rule]", "0"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Coeff6PNLog2", "=", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"Irrational\[Rho]Orb6PN", ",", 
         SuperscriptBox[
          RowBox[{"Log", "[", "x", "]"}], "2"]}], "]"}], ",", 
       SuperscriptBox["x", "6"]}], "]"}]}], ";"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.946027415801301*^9, 3.9460274281772327`*^9}, {
  3.946027480222589*^9, 3.946027612709425*^9}, {3.946027646867436*^9, 
