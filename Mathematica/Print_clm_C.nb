Mathematica/Resumming_rho_orb/New_resumming_with_rational_pade/clm````.json\>\
\"", ",", " ", "l", ",", " ", "m"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<clm\>\"", " ", "\[Rule]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{"clm", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "]"}], "//", "Simplify"}], 
              ",", " ", "InputForm"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "1", ",", " ", 
              RowBox[{"Length", "[", "clm", "]"}]}], "}"}]}], "]"}]}], ",", 
         "\n", "       ", 
         RowBox[{"\"\<prelLog1\>\"", " ", "->", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", "Coeff6PNLog1", "]"}], "//", "Simplify"}], ",",
             " ", "InputForm"}], "]"}]}], ",", "\n", "       ", 
         RowBox[{"\"\<clmLog1\>\"", " ", "\[Rule]", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"N", "[", 
                RowBox[{"clmLog1", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "]"}], "//", "Simplify"}], 
              ",", " ", "InputForm"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"k", ",", " ", "1", ",", 
              RowBox[{"Length", "[", "clmLog1", "]"}]}], "}"}]}], "]"}]}], 
         ",", "\n", "       ", 
         RowBox[{"\"\<clmLog2\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"N", "[", "Coeff6PNLog2", "]"}], "//", "Simplify"}], ",",
             " ", "InputForm"}], "]"}]}]}], "}"}]}], "]"}]}], "]"}], 
   ")"}]}]], "Input",
