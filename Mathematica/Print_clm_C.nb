         RowBox[{
          RowBox[{"Log1\[Rho]Orb6PN", "/.", 
           RowBox[{"\[Nu]", "\[Rule]", "nu"}]}], "/.", "rulenu"}], ",", "x"}],
         "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", " ", ";;"}], "]"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"Export", "[", 
