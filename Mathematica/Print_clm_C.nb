Cell[BoxData[
 RowBox[{
  RowBox[{"PrintClm", "[", 
   RowBox[{"l_", ",", " ", "m_"}], "]"}], " ", ":=", " ", "\n", " ", 
  RowBox[{"(", 
   RowBox[{"CompoundExpression", "[", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"SeparateLogs", "[", 
      RowBox[{"l", ",", "m"}], "]"}], ";", "\n", "  ", 
     RowBox[{"clm", " ", "=", " ", 
      RowBox[{
       RowBox[{"CoefficientList", "[", 
