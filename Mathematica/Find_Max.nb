             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", "i"}], "]"}], "+", 
              RowBox[{"k", " ", "h"}]}], ",", 
             RowBox[{"Subscript", "[", 
              RowBox[{"f", ",", 
               RowBox[{"i", "+", "k"}]}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
