    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"InterpolatingPolynomial", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
