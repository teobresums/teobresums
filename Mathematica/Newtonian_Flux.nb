Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["I think the Phase DISAGREEMENT could be due to sign(m1-m2) in X12 \
introduced above Table V\n", "Section"],
 StyleBox[Cell[BoxData[
  RowBox[{
   StyleBox[
    RowBox[{"If", " ", "we", " ", "use", " ", "m2"}],
    FontColor->GrayLevel[0]], 
   StyleBox[">",
    FontColor->GrayLevel[0]], 
   RowBox[{
    StyleBox["m1",
     FontColor->GrayLevel[0]], 
    StyleBox[" ",
     FontColor->GrayLevel[0]], 
    StyleBox["then",
     FontColor->GrayLevel[0]], 
    StyleBox[" ",
     FontColor->GrayLevel[0]], 
    FormBox[
     RowBox[{
      RowBox[{
       SubscriptBox["X", "2"], "-", 
       SubscriptBox["X", "1"]}], "=", 
      SqrtBox[
       RowBox[{"1", "-", 
        RowBox[{"4", "\[Nu]"}]}]]}],
     TraditionalForm]}]}]], "Section"], "Section"],
 StyleBox["\n", "Section"],
 StyleBox["Let me introduce a factor ", "Section",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], "r"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 StyleBox[" into ", "Section",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "2"], TraditionalForm]],
  FormatType->"TraditionalForm"],
 StyleBox[" which I can set by r=\[PlusMinus]1", "Section",
  FontColor->GrayLevel[0]]
}], "Subsection",
 CellChangeTimes->{{3.7349696010156507`*^9, 3.734969718525489*^9}, {
  3.7349698050618343`*^9, 3.734969820725425*^9}, {3.734972713409361*^9, 
  3.734972781865663*^9}, {3.734977521678183*^9, 3.734977522038856*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p2", "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "r"], 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"4", "\[Nu]"}]}]]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Because", " ", "X2"}], "\[GreaterEqual]", " ", "X1"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"it", " ", "is", " ", "X2"}], "-", "X1"}], " ", "=", " ", 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"4", "\[Nu]"}]}]]}]}], "  ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p3", "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "*", "\[Nu]"}], "-", "1"}], ")"}]}], ";", " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"p3", " ", "is", " ", "off", " ", "by"}], " ", "-", "1"}], " ", 
     "=", " ", 
     RowBox[{"Pi", " ", "phase", " ", "difference"}]}], " ", "*)"}], "\n", 
   RowBox[{"p4", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "*", "\[Nu]"}], "-", "1"}], ")"}], "*", "p2"}]}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{"p6", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"4", "*", "\[Nu]"}], "+", 
      RowBox[{"3", "*", 
       SuperscriptBox["\[Nu]", "2"]}]}], ")"}], "*", "p2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p7", "=", 
    RowBox[{
     RowBox[{"7", "*", 
      SuperscriptBox["\[Nu]", "3"]}], "-", 
     RowBox[{"14", "*", 
      SuperscriptBox["\[Nu]", "2"]}], "+", 
     RowBox[{"7", "*", "\[Nu]"}], "-", "1"}]}], ";", " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"This", " ", "is", " ", "off", " ", "by"}], " ", "-", "1"}], 
     " ", "=", " ", 
     RowBox[{"Pi", " ", "phase", " ", "difference"}]}], "*)"}], "\n", 
   RowBox[{"p8", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4", "*", 
        SuperscriptBox["\[Nu]", "3"]}], "-", 
       RowBox[{"10", "*", 
        SuperscriptBox["\[Nu]", "2"]}], "+", 
       RowBox[{"6", "*", "\[Nu]"}], "-", "1"}], ")"}], "*", "p2"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"This", " ", "is", " ", 
    RowBox[{"Alm", "[", "35", "]"}], " ", "of", " ", 
    RowBox[{"Waveform", ".", 
     RowBox[{"c", ":", "111"}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Alm", "=", 
    RowBox[{"{", 
     RowBox[{
     "p2", ",", "p1", ",", "p2", ",", "p3", ",", "p2", ",", "p4", ",", "p3", 
      ",", "p4", ",", "p3", ",", "p4", ",", "p5", ",", "p4", ",", "p5", ",", 
      "p4", ",", "p6", ",", "p5", ",", "p6", ",", "p5", ",", "p6", ",", "p5", 
      ",", "p6", ",", "p7", ",", "p6", ",", "p7", ",", "p6", ",", "p7", ",", 
      "p6", ",", "p8", ",", "p7", ",", "p8", ",", "p7", ",", "p8", ",", "p7", 
      ",", "p8", ",", "p7"}], "}"}]}], ";"}], "  "}]}], "Input",
 CellChangeTimes->{{3.734964140502005*^9, 3.73496428056956*^9}, {
   3.734964594225499*^9, 3.7349646123507433`*^9}, {3.734964775425046*^9, 
