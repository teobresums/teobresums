Cell[CellGroupData[{

Cell[TextData[{
 "PHASES\n",
 StyleBox["Most of my phases DISAGREE with C\[CloseCurlyQuote]s by \
\[PlusMinus]\[Pi]\nI divide phase difference by 2\[Pi] and Mod by 1, if the \
result is \[NotEqual]0 then phases disagree\nNOTE: C has no phases for Modes \
(8,1) to (8,7). At the BOTTOM I construct these.",
  FontColor->GrayLevel[0]]
}], "Section",
 CellChangeTimes->{{3.734952107544318*^9, 3.734952108632661*^9}, {
