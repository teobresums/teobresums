Cell[CellGroupData[{

Cell[TextData[{
 "l=8 PHASES\n",
 StyleBox["For this there is no data in any of the codes, but my ",
  FontColor->GrayLevel[0]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 StyleBox[" output above combined with sign change of p7 and \
\[PlusMinus]ambiguity  in p8 can be used to obtain the final result for \
Waveform.c:40\nIt turns out adding \[Pi] to the ",
  FontColor->GrayLevel[0]],
 StyleBox["Mathematica",
  FontSlant->"Italic",
  FontColor->GrayLevel[0]],
 StyleBox[" output gives the phase compatible with Waveform.c",
  FontColor->GrayLevel[0]]
}], "Section",
 CellChangeTimes->{{3.734980571945703*^9, 3.734980635138694*^9}, {
  3.7349811300746527`*^9, 3.734981162346797*^9}, {3.734981662115705*^9, 
