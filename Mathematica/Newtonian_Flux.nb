Cell[TextData[{
 "\[ScriptL]=2 CHECK: ",
 StyleBox["(2,2) mode has p1=1 so no problem there, BUT (2,1) has p2 ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{"\[PlusMinus]", 
     SqrtBox[
      RowBox[{"1", "-", 
       RowBox[{"4", "\[Nu]"}]}]]}]}], TraditionalForm]],
  FormatType->"TraditionalForm",
  FontColor->GrayLevel[0]],
 ", so PhaseDiff = \[Pi]"
}], "Subsection",
