Cell[CellGroupData[{

Cell[TextData[{
 "\[ScriptL]=5 CHECK: ",
 StyleBox[" Phases ALL AGREE. (5,2), (5,4) have p5\[CloseCurlyQuote]s so \
phases agree as shown above.\n(5,1), (5,3),(5,5) have p4\[CloseCurlyQuote]s \
which are OFF by -1, so these phases should be off by \[Pi] \nBUT they AGREE \
(mod 2\[Pi]) due to the \[PlusMinus] ambiguity of X12 mentioned above.",
  FontColor->GrayLevel[0]]
}], "Subsection",
 CellChangeTimes->{{3.7349700552461977`*^9, 3.734970118494976*^9}, {
  3.734970607390394*^9, 3.734970665454255*^9}, {3.7349728146933603`*^9, 
