Cell[CellGroupData[{

Cell[TextData[{
 "ATTEMPT TO RECONCILE THE PHASE DIFFERENCES\nMY THEORY: ",
 StyleBox["The Alm[k] that goes into hlmNewt->ampli[k] in C differs from",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", 
    RowBox[{"\[ScriptL]", "+", "\[Epsilon]"}]], TraditionalForm]],
  FormatType->"TraditionalForm",
  FontColor->GrayLevel[0]],
 StyleBox["(\[Nu]) of",
  FontColor->GrayLevel[0]],
 " ",
 StyleBox["Table V of 0811.206 by some (-) signs.\n Therefore there is \
\[PlusMinus]\[Pi] Phase difference for most modes.\nSpecifically, there are \
some differences in the signs of the",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", 
    RowBox[{"\[ScriptL]", "+", "\[Epsilon]"}]], TraditionalForm]],
  FormatType->"TraditionalForm",
  FontColor->GrayLevel[0]],
 StyleBox["(\[Nu]) and p2, p3, p4,p6,p7, p8 of C. Here I call ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   SubscriptBox["c", 
    RowBox[{"\[ScriptL]", "+", "\[Epsilon]"}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 "(\[Nu])",
 StyleBox[" by clms. ",
  FontColor->GrayLevel[0]]
}], "Section",
 CellChangeTimes->{{3.734968623371364*^9, 3.734968841339221*^9}, {
   3.734968874946991*^9, 3.734968884555635*^9}, {3.734968924621108*^9, 
   3.7349690169491243`*^9}, {3.734969078327043*^9, 3.734969136545252*^9}, {
   3.734969469026781*^9, 3.7349694882451353`*^9}, 3.734969541248151*^9, {
   3.734972428800674*^9, 3.7349726084336243`*^9}, {3.734979351320559*^9, 
   3.734979352945359*^9}, {3.734982743996633*^9, 3.734982802604382*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Define", " ", "the", " ", "clms"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"clms", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"l", ",", "m"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "l"}], "}"}]}], "]"}], "]"}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.734963102278879*^9, 3.734963102807981*^9}, {
   3.7349656787858973`*^9, 3.73496568920998*^9}, 3.73496877503308*^9, {
   3.734969309558289*^9, 3.734969338677725*^9}, {3.734969482009591*^9, 
