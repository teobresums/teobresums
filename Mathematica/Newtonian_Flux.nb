Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]", "[", 
    RowBox[{"el_", ",", "em_"}], "]"}], "=", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"el", "+", "em"}], ",", "2"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n0", "[", 
    RowBox[{"el_", ",", "em_"}], "]"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"I", " ", "em"}], ")"}], "el"], 
    FractionBox[
     RowBox[{"8", "\[Pi]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "el"}], "+", "1"}], ")"}], "!!"}]], 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"el", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"el", "+", "2"}], ")"}]}], 
      RowBox[{"el", 
       RowBox[{"(", 
        RowBox[{"el", "-", "1"}], ")"}]}]]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n1", "[", 
    RowBox[{"el_", ",", "em_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"I", " ", "em"}], ")"}], "el"]}], 
    FractionBox[
     RowBox[{"16", " ", "I", " ", "\[Pi]"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "el"}], "+", "1"}], ")"}], "!!"}]], 
    SqrtBox[
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "el"}], "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"el", "+", "2"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["el", "2"], "-", 
         SuperscriptBox["em", "2"]}], ")"}]}], 
      RowBox[{"el", 
       RowBox[{"(", 
        RowBox[{"el", "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"el", "+", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "el"}], "-", "1"}], ")"}]}]]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "[", 
    RowBox[{"el_", ",", "em_"}], "]"}], "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"el", "+", "em"}], ",", "2"}], "]"}], "\[Equal]", "0"}], ",", 
     
     RowBox[{"n0", "[", 
      RowBox[{"el", ",", "em"}], "]"}], ",", 
     RowBox[{"n1", "[", 
      RowBox[{"el", ",", "em"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", "[", 
    RowBox[{"el_", ",", "em_"}], "]"}], "=", 
   RowBox[{"SphericalHarmonicY", "[", 
    RowBox[{
     RowBox[{"el", "-", 
      RowBox[{"\[Epsilon]", "[", 
       RowBox[{"el", ",", "em"}], "]"}]}], ",", 
     RowBox[{"-", "em"}], ",", 
     FractionBox["\[Pi]", "2"], ",", "\[Phi]"}], "]"}]}], ";"}]}], "Input",
